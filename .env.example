# Build-only Airtable access, used by `npm run snapshot`.
# Never needed by the browser: the deployed site reads a static snapshot.
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_airtable_base_id

LANGUAGES_TABLE_ID=your_languages_table_id
WRITING_SYSTEMS_TABLE_ID=your_writing_systems_table_id
NATIONS_TABLE_ID=your_nations_table_id

# Sub-path the site is published under. Empty for local development.
NEXT_PUBLIC_BASE_PATH=/catalogue-of-languages

# Namespacing for the stored filter preferences.
NEXT_PUBLIC_STORAGE_PREFIX=catalogue-of-languages
NEXT_PUBLIC_STORAGE_VERSION=1-0-0
